{
  "swagger": "2.0",
  "info": {
    "title": "User API Documentation",
    "description": "",
    "version": "1.0.0"
  },
  "host": "localhost:3001/api/v1/users",
  "basePath": "/",
  "schemes": [
    "http",
    "https"
  ],
  "paths": {
    "/register": {
      "post": {
        "tags": [
          "utilisateur"
        ],
        "description": "Enregister un nouvelle utilisateur",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "schema": {
              "$ref": "#/definitions/AddUser"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/login": {
      "post": {
        "tags": [
          "utilisateur"
        ],
        "description": "Connection d'un utilisateur",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "schema": {
              "$ref": "#/definitions/Login"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "403": {
            "description": "Forbidden"
          }
        }
      }
    },
    "/debug": {
      "get": {
        "tags": [
          "utilisateur"
        ],
        "description": "Liste tout les utilisateurs",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/user/{userId}": {
      "get": {
        "tags": [
          "utilisateur"
        ],
        "description": "Info sur un utilisateur par son id",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "403": {
            "description": "Forbidden"
          }
        }
      }
    }
  },
  "definitions": {
    "AddUser": {
      "type": "object",
      "properties": {
        "firstname": {
          "type": "string",
          "example": "Armel"
        },
        "lastname": {
          "type": "string",
          "example": "Cloarec"
        },
        "password": {
          "type": "string",
          "example": "motdepasse"
        },
        "mail": {
          "type": "string",
          "example": "ABCDEFG@test.fr"
        },
        "phone": {
          "type": "number",
          "example": 4512
        }
      },
      "required": [
        "firstname",
        "lastname",
        "password",
        "mail"
      ]
    },
    "Login": {
      "type": "object",
      "properties": {
        "mail": {
          "type": "string",
          "example": "ABCDEFG@test.fr"
        },
        "password": {
          "type": "string",
          "example": "motdepasse"
        }
      },
      "required": [
        "mail",
        "password"
      ]
    }
  }
}